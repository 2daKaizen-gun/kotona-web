# 백엔드(kotona-analyzer) 주소
KOTONA_API_URL=http://localhost:8081

# 백엔드에 API_KEY 를 설정한 경우에만 채운다.
# NEXT_PUBLIC_ 접두사가 없으므로 서버에서만 읽히고 브라우저 번들에 포함되지 않는다.
# 이것이 프론트가 백엔드를 직접 부르지 않고 /api/* route handler 를 거치는 이유다.
KOTONA_API_KEY=

# 백엔드 없이 예시만 보여 줄 때 true.
# 주의: /, /history, /phrases 는 정적으로 미리 렌더되므로 이 값은 '빌드 시점'에 읽힌다.
# 빌드 후에 켜면 route handler 만 예시를 주고 배너는 빠져서, 가장 나쁜 조합이 된다.
KOTONA_DEMO=

# 사이트 전체에 거는 비밀번호(HTTP Basic, 사용자 이름은 무엇이든). 비우면 열어 둔다.
# 공개 배포에서 KOTONA_API_KEY 를 채웠다면 이것도 채울 것 — route handler 는 누가 부르든
# 키를 붙여 백엔드로 넘기므로, 비밀번호가 없으면 공개된 프론트가 곧 공개된 백엔드다.
KOTONA_SITE_PASSWORD=
